{
  "Id": "b8e3d1a4-6c2f-4a9e-8d71-3f5c0a2e9b16",
  "Name": "i18n:plugin_name",
  "Author": "qianlifeng",
  "Version": "1.1.0",
  "MinWoxVersion": "2.4.8",
  "Description": "i18n:plugin_description",
  "Website": "https://github.com/qianlifeng/Wox.Plugin.VideoDownloader",
  "Icon": "relative:images/app.svg",
  "TriggerKeywords": ["vd","dl"],
  "SupportedOS": ["windows", "linux", "darwin"],
  "Commands": [
    {
      "Command": "update",
      "Description": "i18n:cmd_update"
    }
  ],
  "Features": [
    {
      "Name": "ignoreAutoScore"
    }
  ],
  "SettingDefinitions": [
    {
      "Type": "head",
      "Value": {
        "Content": "i18n:section_download"
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "download_path",
        "Label": "i18n:setting_download_path",
        "Tooltip": "i18n:setting_download_path_tip",
        "DefaultValue": "",
        "Style": {
          "Width": 420
        }
      },
      "IsPlatformSpecific": true
    },
    {
      "Type": "select",
      "Value": {
        "Key": "preferred_video_format",
        "Label": "i18n:setting_video_format",
        "DefaultValue": "mp4",
        "Options": [
          {
            "Label": "mp4",
            "Value": "mp4"
          },
          {
            "Label": "mkv",
            "Value": "mkv"
          },
          {
            "Label": "webm",
            "Value": "webm"
          },
          {
            "Label": "mov",
            "Value": "mov"
          }
        ]
      }
    },
    {
      "Type": "select",
      "Value": {
        "Key": "preferred_audio_format",
        "Label": "i18n:setting_audio_format",
        "DefaultValue": "mp3",
        "Options": [
          {
            "Label": "mp3",
            "Value": "mp3"
          },
          {
            "Label": "m4a",
            "Value": "m4a"
          },
          {
            "Label": "opus",
            "Value": "opus"
          },
          {
            "Label": "flac",
            "Value": "flac"
          },
          {
            "Label": "wav",
            "Value": "wav"
          },
          {
            "Label": "aac",
            "Value": "aac"
          }
        ]
      }
    },
    {
      "Type": "head",
      "Value": {
        "Content": "i18n:section_cookies"
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "cookie_file_path",
        "Label": "i18n:setting_cookie_path",
        "Tooltip": "i18n:setting_cookie_path_tip",
        "DefaultValue": "",
        "Style": {
          "Width": 420
        }
      },
      "IsPlatformSpecific": true
    },
    {
      "Type": "head",
      "Value": {
        "Content": "i18n:section_trim"
      }
    },
    {
      "Type": "select",
      "Value": {
        "Key": "trim_mode",
        "Label": "i18n:setting_trim_mode",
        "Tooltip": "i18n:setting_trim_mode_tip",
        "DefaultValue": "off",
        "Options": [
          {
            "Label": "i18n:trim_off",
            "Value": "off"
          },
          {
            "Label": "i18n:trim_post",
            "Value": "post"
          },
          {
            "Label": "i18n:trim_native",
            "Value": "native"
          }
        ]
      }
    }
  ],
